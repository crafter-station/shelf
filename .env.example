# Clerk — sign-in is optional/anonymous-first. Without these the shelf still
# works (books live in IndexedDB); set them to enable account sign-in.
# Create an app at https://dashboard.clerk.com and copy its API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon/Postgres — cloud shelf storage (book metadata). Without it the cloud
# routes return 503 and the app stays local-only. Create a database at
# https://neon.tech (or via the Vercel Neon integration) and paste the pooled
# connection string.
DATABASE_URL=

# Vercel Blob — stores the PDF bytes. Auto-injected when you create a Blob store
# on the Vercel project; set it locally for `bun dev` uploads. Without it,
# uploads fail and the shelf stays local-only.
BLOB_READ_WRITE_TOKEN=
